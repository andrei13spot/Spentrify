# Spentrify Backend Environment Variables

# Server Port
PORT=3000

# Environment Mode (development / production)
NODE_ENV=development

# Database Path (defaults to spentrify.db in backend root)
DB_PATH=spentrify.db

# AES-256-GCM Encryption Key (Required: 64 hex characters / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Gemini API Key (Optional: for AI receipt parsing and insights)
GEMINI_API_KEY=your_gemini_api_key_here

